# Copy to backend/.env and fill in. Never commit the real file.
DATABASE_URL=postgresql+psycopg2://collectiq:collectiq@localhost:5432/collectiq
SECRET_KEY=generate-a-random-64-char-string
ENVIRONMENT=development

# Clerk (Dashboard -> API keys)
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Who becomes admin on first sign-in (everyone else is a read-only viewer)
ADMIN_EMAILS=you@example.com
# Organisation new users join (slug); empty = first organisation
DEFAULT_ORG_SLUG=

# Public read-only demo button on the sign-in page
DEMO_ENABLED=true

# --- Hardening (defaults shown) ---
# ENABLE_DOCS=false              # /docs is hidden in production unless true
# RATE_LIMIT_DEFAULT=240/minute  # per client IP
# RATE_LIMIT_HEAVY=10/minute     # imports, exports, batch prediction
# AUTO_PROVISION_USERS=true      # false = invite-only (only existing users and ADMIN_EMAILS)
# MAX_REQUEST_BYTES=26214400
# IMPORT_MAX_ROWS=20000
